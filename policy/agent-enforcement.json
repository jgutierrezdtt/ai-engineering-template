{
  "schema_version": 1,
  "context_max_bytes": 65536,
  "minimum_claude_version": "2.1.295",
  "validated_codex_version": "0.160.1",
  "editable_roots": [
    "src",
    "app",
    "apps",
    "lib",
    "cmd",
    "internal",
    "services",
    "packages",
    "agents",
    "evals",
    "infra",
    "tests/product",
    "docs"
  ],
  "editable_files": [
    "README.md"
  ],
  "read_commands": [
    "pwd",
    "rg --files",
    "rg --files --hidden"
  ],
  "validation_commands": [
    "python3 -B tools/quality.py bootstrap",
    "python3 -B tools/quality.py quick",
    "python3 -B tools/quality.py release"
  ]
}
